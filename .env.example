# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key used to sign and verify JWT authentication tokens (use a strong 32+ char string in production).
JWT_SECRET="replace-with-a-strong-random-jwt-secret-key"

# PostgreSQL Connection (Optional — when configured, the app automatically persists all data to PostgreSQL).
# You can provide DATABASE_URL OR individual PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE variables.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codeexam"
# PGHOST="localhost"
# PGPORT="5432"
# PGUSER="postgres"
# PGPASSWORD="postgres"
# PGDATABASE="codeexam"
# PGSSL="false"
